# Required in production. Without it the app refuses to serve, so a deploy is never public by accident.
APP_PASSWORD=choose-a-long-password

# Lets iOS Shortcuts and the notification cron call the app without signing in.
APP_TOKEN=generate-a-random-string

# Turso (production database). Leave unset locally to use ./data/macros.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Food photo storage on Vercel Blob. Unset locally, so photos go to ./data/photos.
BLOB_READ_WRITE_TOKEN=

# Optional: the AI key can live here instead of in Settings.
GEMINI_API_KEY=
